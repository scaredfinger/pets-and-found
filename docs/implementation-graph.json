      "kind": "package-unit",
      "package": "@scaffold/greeting",
      "globs": ["libs/greeting/src/**"],
      "tests": ["pnpm --filter @scaffold/greeting test"]
    },
    "database": {
      "kind": "package-unit",
      "package": "@scaffold/db",
      "globs": ["libs/db/src/**", "libs/db/migrations/**"],
      "tests": ["pnpm --filter @scaffold/db test", "pnpm e2e"]
    },
    "project": {
      "kind": "consumer",
