              "tests/acceptance/features/pool-recovery.ts",
              "tests/acceptance/features/reports.feature",
              "tests/acceptance/features/reports.ts"
            ],
          "tests": [
            "pnpm --filter @scaffold/acceptance test"
          ]
        }
      }
    },
    "database-infrastructure": {
      "kind": "configuration",
      "files": ["compose.yaml"],
      "tests": ["docker compose config --quiet", "pnpm e2e"]
    },
    "ci": {
      "kind": "configuration",
      "files": [".github/workflows/architecture.yml"],
      "tests": ["pnpm test", "pnpm test:arch", "pnpm test:pets-and-found", "pnpm e2e", "pnpm build"]
    },
    "browser-tests": {
      "kind": "test-suite",
      "globs": ["tests/browser/**"],
      "tests": ["pnpm test:browser"]
    },
    "backend": {
      "kind": "package-unit",
      "package": "@scaffold/backend",
      "globs": ["apps/backend/src/**"],
      "tests": ["pnpm --filter @scaffold/backend test"]
